{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebuy-admin-ui",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
